# NEXUS Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.

PROJECT_NAME="NEXUS Core"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 with pgvector)
# Host port 5433 avoids collision with default 5432
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus_dev
POSTGRES_PORT=5433
DATABASE_URL="postgresql+asyncpg://nexus:nexus@localhost:5433/nexus_dev"
DATABASE_URL_SYNC="postgresql+psycopg://nexus:nexus@localhost:5433/nexus_dev"

# Ephemeral / Cache Configuration (Redis 7)
# Host port 6380 avoids collision with default 6379
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380/0"

# Auth & Session Security Configuration (ADR-020)
# Minimum 32 characters in production; change immediately for non-development environments
JWT_SECRET_KEY="nexus-dev-insecure-jwt-secret-key-change-in-production-min32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Apple Sign-In Provider Configuration (Mock verifier used in development/test)
APPLE_CLIENT_ID="com.nexus.app"
