# NEXUS Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate.

PROJECT_NAME="NEXUS Core"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus_dev
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_dev"
DATABASE_URL_SYNC="postgresql+psycopg://nexus:nexus@localhost:5432/nexus_dev"

# Ephemeral / Cache Configuration (Redis 7)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
