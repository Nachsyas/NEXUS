# NEXUS Phase 1 Environment Configuration Template
# Salin file ini menjadi .env untuk pengujian lokal
# CATATAN: Nilai di bawah ini merupakan template placeholder, bukan komitmen infrastruktur final.

# Environment Mode
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=
API_PREFIX=/api/v1

# Database (PostgreSQL + pgvector — Engine versi major dievaluasi di TBD-026)
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Cache & Ephemeral State (Redis)
REDIS_URL=

# Object Storage (S3-Compatible Baseline — Provider lokal/prod berstatus TBD-002 / TBD-016)
# Neutral placeholders (dilarang mengasumsikan provider tertentu seperti MinIO sebelum disetujui)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=

# Apple Auth (Sign in with Apple)
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Realtime WebSocket (Timing, threshold, dan interval dievaluasi di TBD-022)
WS_HEARTBEAT_INTERVAL_SECONDS=
WS_HEARTBEAT_TIMEOUT_SECONDS=

# Model Router (TBD-003, TBD-004)
# Default placeholders, diisi saat provider disetujui via ADR
PRIMARY_LLM_PROVIDER=
PRIMARY_EMBEDDING_PROVIDER=
